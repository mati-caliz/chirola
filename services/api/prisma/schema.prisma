generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  issuers       Issuer[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Issuer {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cuit         String
  legalName    String
  ivaCondition String
  environment  String       @default("homologacion")
  cbu          String?
  paymentAlias String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  certificate      Certificate?
  salesPoints      SalesPoint[]
  clients          Client[]
  vouchers         Voucher[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([userId, cuit, environment])
}

model PurchaseInvoice {
  id           String    @id @default(cuid())
  issuerId     String
  issuer       Issuer    @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  supplierCuit String
  supplierName String
  invoiceType  Int
  salesPoint   Int
  number       Int
  issueDate    DateTime
  dueDate      DateTime?
  netAmount21  Decimal   @default(0) @db.Decimal(15, 2)
  iva21        Decimal   @default(0) @db.Decimal(15, 2)
  netAmount105 Decimal   @default(0) @db.Decimal(15, 2)
  iva105       Decimal   @default(0) @db.Decimal(15, 2)
  netAmount27  Decimal   @default(0) @db.Decimal(15, 2)
  iva27        Decimal   @default(0) @db.Decimal(15, 2)
  exempt       Decimal   @default(0) @db.Decimal(15, 2)
  untaxed      Decimal   @default(0) @db.Decimal(15, 2)
  total        Decimal   @db.Decimal(15, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([issuerId, issueDate])
}

model Certificate {
  id            String    @id @default(cuid())
  issuerId      String    @unique
  issuer        Issuer    @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  privateKeyEnc String
  csrPem        String?
  certPem       String?
  alias         String?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SalesPoint {
  id          String    @id @default(cuid())
  issuerId    String
  issuer      Issuer    @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  number      Int
  description String?
  vouchers    Voucher[]

  @@unique([issuerId, number])
}

model Client {
  id           String    @id @default(cuid())
  issuerId     String
  issuer       Issuer    @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  docType      Int
  docNumber    String
  legalName    String?
  ivaCondition String?
  email        String?
  vouchers     Voucher[]

  @@unique([issuerId, docType, docNumber])
}

model Voucher {
  id           String     @id @default(cuid())
  issuerId     String
  issuer       Issuer     @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  salesPointId String
  salesPoint   SalesPoint @relation(fields: [salesPointId], references: [id])
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id])

  voucherType Int
  number      Int
  voucherDate DateTime
  concept     Int

  serviceFrom    DateTime?
  serviceTo      DateTime?
  paymentDueDate DateTime?

  netAmount     Decimal @db.Decimal(15, 2)
  ivaAmount     Decimal @db.Decimal(15, 2)
  exemptAmount  Decimal @default(0) @db.Decimal(15, 2)
  untaxedAmount Decimal @default(0) @db.Decimal(15, 2)
  tributeAmount Decimal @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal @db.Decimal(15, 2)
  currency      String  @default("PES")
  exchangeRate  Decimal @default(1) @db.Decimal(15, 6)

  tributes Json?

  status             String    @default("PENDING")
  cae                String?
  caeExpiration      DateTime?
  qrData             String?
  arcaObservations   Json?
  associatedVouchers Json?
  exportDetail       Json?

  items     VoucherItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([salesPointId, voucherType, number])
}

model ApiClient {
  id        String            @id @default(cuid())
  name      String            @unique
  keyHash   String
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  issuers   ApiClientIssuer[]
  webhooks  WebhookEndpoint[]
}

model WebhookEndpoint {
  id          String    @id @default(cuid())
  apiClientId String
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([apiClientId])
}

model ApiClientIssuer {
  id          String    @id @default(cuid())
  apiClientId String
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  issuerId    String
  createdAt   DateTime  @default(now())

  @@unique([apiClientId, issuerId])
  @@index([issuerId])
}

model ShadowComparison {
  id          String   @id @default(cuid())
  apiClientId String
  issuerId    String
  salesPoint  Int
  voucherType Int
  matched     Boolean
  differences Json
  expected    Json
  computed    Json
  createdAt   DateTime @default(now())

  @@index([issuerId, createdAt])
}

model ServiceAuditLog {
  id          String   @id @default(cuid())
  apiClientId String
  issuerId    String?
  method      String
  path        String
  outcome     String
  resourceId  String?
  detail      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([apiClientId, createdAt])
}

model ArcaCallLog {
  id           String   @id @default(cuid())
  issuerId     String?
  service      String
  operation    String
  httpStatus   Int
  durationMs   Int
  outcome      String
  errorCodes   String?
  requestXml   String   @db.Text
  responseXml  String   @db.Text
  createdAt    DateTime @default(now())

  @@index([issuerId, createdAt])
  @@index([createdAt])
}

model AccessTicketCache {
  id         String   @id @default(cuid())
  issuerId   String
  service    String
  token      String   @db.Text
  sign       String   @db.Text
  generation DateTime
  expiration DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([issuerId, service])
}

model ArcaParamCache {
  id        String   @id @default(cuid())
  issuerId  String
  paramType String
  entries   Json
  fetchedAt DateTime @default(now())

  @@unique([issuerId, paramType])
}

model TaxpayerCache {
  id             String   @id @default(cuid())
  cuit           String   @unique
  legalName      String
  status         String
  ivaConditionId Int
  address        Json?
  fetchedAt      DateTime @default(now())
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  issuerId  String
  key       String
  voucherId String
  createdAt DateTime @default(now())

  @@unique([issuerId, key])
}

model PendingVoucher {
  id             String   @id @default(cuid())
  issuerId       String
  idempotencyKey String?
  payload        Json
  status         String   @default("PENDING")
  retryCount     Int      @default(0)
  nextRetryAt    DateTime

  attemptedNumber     Int?
  attemptedSalesPoint Int?
  attemptedAt         DateTime?
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([issuerId, idempotencyKey])
  @@index([status, nextRetryAt])
}

model VoucherItem {
  id          String  @id @default(cuid())
  voucherId   String
  voucher     Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(15, 4)
  unitPrice   Decimal @db.Decimal(15, 4)
  ivaRate     Decimal @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(15, 2)

  taxTreatment String @default("TAXED")
}
